{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pixel.local/schemas/activation-v2-route-shadow-receipt-v1.json",
  "title": "ActivationV2RouteShadowReceiptV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "receipt_id",
    "case_id",
    "classifier_version",
    "registry_version",
    "registry_digest",
    "input_digest",
    "expected_profile_alias",
    "selected_profile_alias",
    "effort_intent",
    "selection_reason",
    "reason_codes",
    "match_status",
    "fallback_used",
    "latency_within_budget",
    "model_classifier_calls",
    "provider_network_calls",
    "session_created",
    "default_changed",
    "prompt_persisted",
    "fixture_only",
    "authority_write",
    "global_write",
    "created_at",
    "receipt_digest"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "receipt_id": {
      "type": "string",
      "pattern": "^route-shadow-receipt:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "maxLength": 57
    },
    "case_id": {
      "type": "string",
      "pattern": "^route-shadow-case:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "maxLength": 54
    },
    "classifier_version": {"const": "activation-v2-a6/1"},
    "registry_version": {"const": 2},
    "registry_digest": {"$ref": "#/$defs/hash"},
    "input_digest": {"$ref": "#/$defs/hash"},
    "expected_profile_alias": {"$ref": "#/$defs/profile_alias"},
    "selected_profile_alias": {"$ref": "#/$defs/profile_alias"},
    "effort_intent": {"enum": ["high", "max", "xhigh"]},
    "selection_reason": {
      "enum": [
        "explicit_user_safe",
        "safety_override",
        "rule_read_explanation",
        "rule_scoped_implementation",
        "rule_difficult_debugging",
        "rule_finite_utility",
        "fallback_luna_gate",
        "fallback_uncertainty"
      ]
    },
    "reason_codes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "enum": [
          "EXPLICIT_PROFILE_PRESERVED",
          "HIGH_RISK_OR_AMBIGUOUS",
          "CROSS_PROJECT_SCOPE",
          "MULTI_STEP_SCOPE",
          "LUNA_HARD_GATE_FAILED",
          "UNKNOWN_STRUCTURED_SHAPE",
          "RULE_MATCH"
        ]
      }
    },
    "match_status": {"enum": ["MATCH", "MISMATCH_PROFILE"]},
    "fallback_used": {"type": "boolean"},
    "latency_within_budget": {"const": true},
    "model_classifier_calls": {"const": 0},
    "provider_network_calls": {"const": 0},
    "session_created": {"const": false},
    "default_changed": {"const": false},
    "prompt_persisted": {"const": false},
    "fixture_only": {"const": true},
    "authority_write": {"const": false},
    "global_write": {"const": false},
    "created_at": {"type": "string", "format": "date-time"},
    "receipt_digest": {"$ref": "#/$defs/hash"}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$", "maxLength": 64},
    "profile_alias": {
      "enum": ["tera-max", "tera-xhigh", "tera-high", "sol-max", "sol-xhigh", "luna-xhigh", "gpt55-xhigh"]
    }
  }
}
