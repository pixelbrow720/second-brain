{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pixel.local/schemas/activation-v2-route-shadow-report-v1.json",
  "title": "ActivationV2RouteShadowReportV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "report_id",
    "corpus_id",
    "corpus_digest",
    "case_count",
    "matched_count",
    "fallback_count",
    "max_observed_latency_ms",
    "latency_budget_ms",
    "receipt_bindings",
    "model_classifier_calls",
    "provider_network_calls",
    "sessions_created",
    "defaults_changed",
    "fixture_only",
    "authority_write",
    "global_write",
    "status",
    "created_at",
    "report_digest"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "report_id": {
      "type": "string",
      "pattern": "^route-shadow-report:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "maxLength": 56
    },
    "corpus_id": {
      "type": "string",
      "pattern": "^route-shadow-corpus:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "maxLength": 56
    },
    "corpus_digest": {"$ref": "#/$defs/hash"},
    "case_count": {"type": "integer", "minimum": 1, "maximum": 16},
    "matched_count": {"type": "integer", "minimum": 1, "maximum": 16},
    "fallback_count": {"type": "integer", "minimum": 0, "maximum": 16},
    "max_observed_latency_ms": {"type": "integer", "minimum": 0, "maximum": 1000},
    "latency_budget_ms": {"type": "integer", "minimum": 1, "maximum": 1000},
    "receipt_bindings": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {"$ref": "#/$defs/receipt_binding"}
    },
    "model_classifier_calls": {"const": 0},
    "provider_network_calls": {"const": 0},
    "sessions_created": {"const": 0},
    "defaults_changed": {"const": 0},
    "fixture_only": {"const": true},
    "authority_write": {"const": false},
    "global_write": {"const": false},
    "status": {"const": "PASS"},
    "created_at": {"type": "string", "format": "date-time"},
    "report_digest": {"$ref": "#/$defs/hash"}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$", "maxLength": 64},
    "receipt_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["receipt_id", "receipt_digest"],
      "properties": {
        "receipt_id": {
          "type": "string",
          "pattern": "^route-shadow-receipt:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "maxLength": 57
        },
        "receipt_digest": {"$ref": "#/$defs/hash"}
      }
    }
  }
}
