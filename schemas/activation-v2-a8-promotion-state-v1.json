{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pixel.local/schemas/activation-v2-a8-promotion-state-v1.json",
  "title": "ActivationV2A8PromotionStateV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "packet_id", "packet_digest", "corpus_digest", "a7_packet_digest", "runtime_id", "synthetic_project_id", "state_revision", "phase", "candidates", "state_digest"],
  "properties": {
    "schema_version": {"const": 1}, "packet_id": {"$ref": "#/$defs/packet_id"}, "packet_digest": {"$ref": "#/$defs/hash"}, "corpus_digest": {"$ref": "#/$defs/hash"}, "a7_packet_digest": {"$ref": "#/$defs/hash"}, "runtime_id": {"$ref": "#/$defs/runtime_id"}, "synthetic_project_id": {"$ref": "#/$defs/project_id"}, "state_revision": {"type": "integer", "minimum": 0, "maximum": 2}, "phase": {"enum": ["initialized", "promoted", "restored"]}, "candidates": {"type": "array", "minItems": 1, "maxItems": 8, "items": {"$ref": "#/$defs/candidate_state"}}, "state_digest": {"$ref": "#/$defs/hash"}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$", "maxLength": 64},
    "project_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$", "maxLength": 64},
    "packet_id": {"type": "string", "pattern": "^a8-packet:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$", "maxLength": 46},
    "runtime_id": {"type": "string", "pattern": "^runtime:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$", "maxLength": 44},
    "candidate_id": {"type": "string", "pattern": "^a8-candidate:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$", "maxLength": 49},
    "global_object_id": {"type": "string", "pattern": "^kb:global:claim:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$", "maxLength": 64},
    "candidate_state": {"type": "object", "additionalProperties": false, "required": ["candidate_id", "source_project_id", "global_object_id", "content_digest", "object_revision", "promotion_state"], "properties": {"candidate_id": {"$ref": "#/$defs/candidate_id"}, "source_project_id": {"$ref": "#/$defs/project_id"}, "global_object_id": {"$ref": "#/$defs/global_object_id"}, "content_digest": {"$ref": "#/$defs/hash"}, "object_revision": {"type": "integer", "minimum": 0, "maximum": 2147483647}, "promotion_state": {"enum": ["before", "promoted", "restored"]}}}
  }
}
