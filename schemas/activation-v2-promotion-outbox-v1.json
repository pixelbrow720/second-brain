{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pixel.local/schemas/activation-v2-promotion-outbox-v1.json",
  "title": "ActivationV2PromotionOutboxV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "outbox_id",
    "origin_closure_id",
    "origin_closure_digest",
    "project_id",
    "source_store",
    "target_store",
    "created_at",
    "idempotency_key",
    "operation",
    "source_objects",
    "review_state",
    "reviewed_at",
    "global_write_committed",
    "proposal_digest"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "outbox_id": {
      "type": "string",
      "pattern": "^promotion:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "maxLength": 46
    },
    "origin_closure_id": {
      "type": "string",
      "pattern": "^closure:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "maxLength": 44
    },
    "origin_closure_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$", "maxLength": 64},
    "project_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$",
      "maxLength": 64
    },
    "source_store": {
      "type": "string",
      "pattern": "^project:[a-z0-9][a-z0-9._-]{0,63}$",
      "maxLength": 72
    },
    "target_store": {"const": "knowledge:global"},
    "created_at": {"type": "string", "format": "date-time"},
    "idempotency_key": {
      "type": "string",
      "pattern": "^promotion:[a-z0-9][a-z0-9._-]{0,63}:[0-9a-f]{64}$",
      "maxLength": 139
    },
    "operation": {
      "enum": ["create_claim", "refine_claim", "create_synthesis"]
    },
    "source_objects": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/source_object"}
    },
    "review_state": {"const": "pending_review"},
    "reviewed_at": {"const": null},
    "global_write_committed": {"const": false},
    "proposal_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$", "maxLength": 64}
  },
  "$defs": {
    "source_object": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "revision", "content_hash"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^mem:[a-z0-9][a-z0-9._-]{0,63}:(?:project|decision|component|task|bug|experiment|evidence|question):[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "maxLength": 128
        },
        "revision": {"type": "integer", "minimum": 1, "maximum": 2147483647},
        "content_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$", "maxLength": 64}
      }
    }
  }
}
