{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pixel.local/schemas/activation-v2-graph-snapshot-v1.json",
  "title": "ActivationV2GraphSnapshotV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "snapshot_id",
    "scope",
    "project_id",
    "generated_at",
    "derived_only",
    "source_snapshots",
    "nodes",
    "edges",
    "snapshot_digest"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "snapshot_id": {
      "type": "string",
      "pattern": "^graph-snapshot:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "maxLength": 52
    },
    "scope": {"const": "project_focus"},
    "project_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$",
      "maxLength": 64
    },
    "generated_at": {"type": "string", "format": "date-time"},
    "derived_only": {"const": true},
    "source_snapshots": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "items": {"$ref": "#/$defs/source_snapshot"}
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {"$ref": "#/$defs/node"}
    },
    "edges": {
      "type": "array",
      "maxItems": 256,
      "items": {"$ref": "#/$defs/edge"}
    },
    "snapshot_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$", "maxLength": 64}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$", "maxLength": 64},
    "source_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["store_id", "mutation_epoch", "corpus_digest"],
      "properties": {
        "store_id": {
          "type": "string",
          "pattern": "^(?:knowledge:global|project:[a-z0-9][a-z0-9._-]{0,63})$",
          "maxLength": 80
        },
        "mutation_epoch": {"type": "integer", "minimum": 0, "maximum": 2147483647},
        "corpus_digest": {"$ref": "#/$defs/hash"}
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "revision", "store_id", "kind", "lifecycle", "freshness", "label"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^(?:kb:global:(?:source|entity|concept|claim|synthesis)|mem:[a-z0-9][a-z0-9._-]{0,63}:(?:project|decision|component|task|bug|experiment|evidence|question)):[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "maxLength": 128
        },
        "revision": {"type": "integer", "minimum": 1, "maximum": 2147483647},
        "store_id": {
          "type": "string",
          "pattern": "^(?:knowledge:global|project:[a-z0-9][a-z0-9._-]{0,63})$",
          "maxLength": 80
        },
        "kind": {
          "enum": ["source", "entity", "concept", "claim", "synthesis", "project", "decision", "component", "task", "bug", "experiment", "evidence", "question"]
        },
        "lifecycle": {"enum": ["active", "superseded", "archived", "deleted"]},
        "freshness": {"enum": ["fresh", "partial", "stale", "unverifiable", "not_applicable"]},
        "label": {"type": "string", "minLength": 1, "maxLength": 140}
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "edge_id",
        "relation",
        "source_id",
        "target_id",
        "source_revision",
        "target_revision",
        "cross_store",
        "provenance_ids",
        "cross_store_provenance"
      ],
      "properties": {
        "edge_id": {
          "type": "string",
          "pattern": "^edge:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "maxLength": 41
        },
        "relation": {
          "enum": ["depends_on", "implements", "verifies", "supports", "contradicts", "derived_from", "about", "part_of", "supersedes", "refines", "related_to"]
        },
        "source_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "target_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "source_revision": {"type": "integer", "minimum": 1, "maximum": 2147483647},
        "target_revision": {"type": "integer", "minimum": 1, "maximum": 2147483647},
        "cross_store": {"type": "boolean"},
        "provenance_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^prov:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
            "maxLength": 41
          }
        },
        "cross_store_provenance": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["direction", "project_object_id", "project_object_revision", "repository_snapshot_digest"],
          "properties": {
            "direction": {"const": "project_to_global"},
            "project_object_id": {
              "type": "string",
              "pattern": "^mem:[a-z0-9][a-z0-9._-]{0,63}:(?:project|decision|component|task|bug|experiment|evidence|question):[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
              "maxLength": 128
            },
            "project_object_revision": {"type": "integer", "minimum": 1, "maximum": 2147483647},
            "repository_snapshot_digest": {"$ref": "#/$defs/hash"}
          }
        }
      }
    }
  }
}
