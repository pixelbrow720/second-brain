{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pixel.local/schemas/activation-v2-route-shadow-corpus-v1.json",
  "title": "ActivationV2RouteShadowCorpusV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "corpus_id",
    "data_class",
    "evaluated_at",
    "latency_budget_ms",
    "intents",
    "corpus_digest"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "corpus_id": {"$ref": "#/$defs/corpus_id"},
    "data_class": {"const": "PUBLIC_SYNTHETIC"},
    "evaluated_at": {"type": "string", "format": "date-time"},
    "latency_budget_ms": {"type": "integer", "minimum": 1, "maximum": 1000},
    "intents": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {"$ref": "#/$defs/intent"}
    },
    "corpus_digest": {"$ref": "#/$defs/hash"}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$", "maxLength": 64},
    "corpus_id": {
      "type": "string",
      "pattern": "^route-shadow-corpus:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "maxLength": 56
    },
    "case_id": {
      "type": "string",
      "pattern": "^route-shadow-case:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "maxLength": 54
    },
    "profile_alias": {
      "enum": ["tera-max", "tera-xhigh", "tera-high", "sol-max", "sol-xhigh", "luna-xhigh", "gpt55-xhigh"]
    },
    "luna_hard_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "output_schema_finite",
        "scope_bounded",
        "non_sensitive",
        "no_architecture_or_security_judgment",
        "no_external_or_destructive_action",
        "no_scope_expansion",
        "deterministically_verifiable"
      ],
      "properties": {
        "output_schema_finite": {"type": "boolean"},
        "scope_bounded": {"type": "boolean"},
        "non_sensitive": {"type": "boolean"},
        "no_architecture_or_security_judgment": {"type": "boolean"},
        "no_external_or_destructive_action": {"type": "boolean"},
        "no_scope_expansion": {"type": "boolean"},
        "deterministically_verifiable": {"type": "boolean"}
      }
    },
    "intent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "task_shape",
        "admission_lane",
        "high_risk",
        "ambiguous",
        "cross_project",
        "multi_step",
        "explicit_profile_alias",
        "explicit_override_allowed",
        "luna_hard_gate",
        "expected_profile_alias"
      ],
      "properties": {
        "case_id": {"$ref": "#/$defs/case_id"},
        "task_shape": {
          "enum": [
            "read_explanation",
            "ambiguous_plan",
            "scoped_implementation",
            "difficult_debugging",
            "finite_utility",
            "unknown"
          ]
        },
        "admission_lane": {"enum": ["DIRECT", "ASSISTED", "GRAPH", "DEEP"]},
        "high_risk": {"type": "boolean"},
        "ambiguous": {"type": "boolean"},
        "cross_project": {"type": "boolean"},
        "multi_step": {"type": "boolean"},
        "explicit_profile_alias": {
          "anyOf": [{"$ref": "#/$defs/profile_alias"}, {"type": "null"}]
        },
        "explicit_override_allowed": {"type": "boolean"},
        "luna_hard_gate": {"$ref": "#/$defs/luna_hard_gate"},
        "expected_profile_alias": {"$ref": "#/$defs/profile_alias"}
      }
    }
  }
}
