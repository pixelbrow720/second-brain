{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pixel.local/schemas/activation-v2-a8-promotion-corpus-v1.json",
  "title": "ActivationV2A8PromotionCorpusV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "corpus_id", "data_class", "synthetic_project_id", "a7_packet_id", "a7_packet_digest", "implementation_digest", "captured_at", "expires_at", "candidates", "corpus_digest"],
  "properties": {
    "schema_version": {"const": 1},
    "corpus_id": {"$ref": "#/$defs/corpus_id"},
    "data_class": {"const": "PUBLIC_SYNTHETIC"},
    "synthetic_project_id": {"$ref": "#/$defs/project_id"},
    "a7_packet_id": {"$ref": "#/$defs/a7_packet_id"},
    "a7_packet_digest": {"$ref": "#/$defs/hash"},
    "implementation_digest": {"$ref": "#/$defs/hash"},
    "captured_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "candidates": {"type": "array", "minItems": 1, "maxItems": 8, "items": {"$ref": "#/$defs/candidate"}},
    "corpus_digest": {"$ref": "#/$defs/hash"}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$", "maxLength": 64},
    "uuid": {"type": "string", "pattern": "[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}"},
    "project_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$", "maxLength": 64},
    "a7_packet_id": {"type": "string", "pattern": "^a7-packet:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$", "maxLength": 46},
    "corpus_id": {"type": "string", "pattern": "^a8-promotion-corpus:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$", "maxLength": 58},
    "candidate_id": {"type": "string", "pattern": "^a8-candidate:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$", "maxLength": 49},
    "project_object_id": {"type": "string", "pattern": "^mem:[a-z0-9][a-z0-9._-]{0,63}:(project|decision|component|task|bug|experiment|evidence|question):[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$", "maxLength": 160},
    "global_object_id": {"type": "string", "pattern": "^kb:global:claim:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$", "maxLength": 64},
    "closure_proposal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "proposal_id", "closure_id", "closure_digest", "project_id", "created_at", "capture_mode", "candidate_counts", "project_write_state", "global_outbox_state", "authority_write", "global_write", "proposal_digest"],
      "properties": {
        "schema_version": {"const": 1},
        "proposal_id": {"type": "string", "pattern": "^closure-proposal:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$", "maxLength": 53},
        "closure_id": {"type": "string", "pattern": "^closure:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$", "maxLength": 44},
        "closure_digest": {"$ref": "#/$defs/hash"},
        "project_id": {"$ref": "#/$defs/project_id"},
        "created_at": {"type": "string", "format": "date-time"},
        "capture_mode": {"const": "ASSISTED"},
        "candidate_counts": {
          "type": "object", "additionalProperties": false,
          "required": ["decisions", "evidence", "open_tasks", "questions", "global_candidates"],
          "properties": {
            "decisions": {"type": "integer", "minimum": 0, "maximum": 32},
            "evidence": {"type": "integer", "minimum": 0, "maximum": 32},
            "open_tasks": {"type": "integer", "minimum": 0, "maximum": 32},
            "questions": {"type": "integer", "minimum": 0, "maximum": 32},
            "global_candidates": {"type": "integer", "minimum": 0, "maximum": 32}
          }
        },
        "project_write_state": {"const": "pending_review"},
        "global_outbox_state": {"const": "pending_review"},
        "authority_write": {"const": false},
        "global_write": {"const": false},
        "proposal_digest": {"$ref": "#/$defs/hash"}
      }
    },
    "review_receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "review_id", "proposal_id", "project_id", "reviewed_at", "decision", "reviewer_kind", "authority_write", "global_write", "receipt_digest"],
      "properties": {
        "schema_version": {"const": 1},
        "review_id": {"type": "string", "pattern": "^proposal-review:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$", "maxLength": 53},
        "proposal_id": {"type": "string", "pattern": "^closure-proposal:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$", "maxLength": 53},
        "project_id": {"$ref": "#/$defs/project_id"},
        "reviewed_at": {"type": "string", "format": "date-time"},
        "decision": {"const": "approved_for_later_transaction"},
        "reviewer_kind": {"const": "synthetic_fixture"},
        "authority_write": {"const": false},
        "global_write": {"const": false},
        "receipt_digest": {"$ref": "#/$defs/hash"}
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_id", "source_project_id", "closure_proposal", "review_receipt", "source_object_ids", "global_object_id", "global_object_revision", "before_digest", "candidate_after_digest", "candidate_digest"],
      "properties": {
        "candidate_id": {"$ref": "#/$defs/candidate_id"},
        "source_project_id": {"$ref": "#/$defs/project_id"},
        "closure_proposal": {"$ref": "#/$defs/closure_proposal"},
        "review_receipt": {"$ref": "#/$defs/review_receipt"},
        "source_object_ids": {"type": "array", "minItems": 1, "maxItems": 12, "items": {"$ref": "#/$defs/project_object_id"}},
        "global_object_id": {"$ref": "#/$defs/global_object_id"},
        "global_object_revision": {"type": "integer", "minimum": 0, "maximum": 2147483647},
        "before_digest": {"$ref": "#/$defs/hash"},
        "candidate_after_digest": {"$ref": "#/$defs/hash"},
        "candidate_digest": {"$ref": "#/$defs/hash"}
      }
    }
  }
}
