        },
        "raw_model_slug": {
          "enum": [
            "cx/gpt-5.6-terra",
            "cx/gpt-5.6-sol",
            "cx/gpt-5.6-luna",
            "cx/gpt-5.5"
          ]
        },
        "router_version": {
          "const": "9router/0.5.40"
        },
        "serialized_effort_field": {
          "const": "model_reasoning_effort"
        },
        "serialized_effort_value": {
          "enum": [
            "high",
            "max",
            "xhigh"
          ]
        }
      },
      "required": [
        "raw_model_slug",
        "serialized_effort_field",
        "serialized_effort_value",
        "adapter_version",
        "client_version",
        "router_version",
        "normalization_rules_version",
        "mapping_evidence"
      ],
      "type": "object"
    },
    "profile": {
      "additionalProperties": false,
      "properties": {
