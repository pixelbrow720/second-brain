{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pixel.local/schemas/activation-v2-task-closure-v1.json",
  "title": "ActivationV2TaskClosureV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "closure_id",
    "project_id",
    "task_outcome",
    "closed_at",
    "redaction_status",
    "decisions",
    "evidence",
    "open_tasks",
    "questions",
    "global_candidates"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "closure_id": {
      "type": "string",
      "pattern": "^closure:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "maxLength": 44
    },
    "project_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$",
      "maxLength": 64
    },
    "task_outcome": {
      "enum": ["completed", "partial", "blocked", "no_durable_change"]
    },
    "closed_at": {"type": "string", "format": "date-time"},
    "redaction_status": {"const": "pass"},
    "decisions": {
      "type": "array",
      "maxItems": 16,
      "items": {"$ref": "#/$defs/decision"}
    },
    "evidence": {
      "type": "array",
      "maxItems": 32,
      "items": {"$ref": "#/$defs/evidence"}
    },
    "open_tasks": {
      "type": "array",
      "maxItems": 16,
      "items": {"$ref": "#/$defs/open_task"}
    },
    "questions": {
      "type": "array",
      "maxItems": 16,
      "items": {"$ref": "#/$defs/question"}
    },
    "global_candidates": {
      "type": "array",
      "maxItems": 16,
      "items": {"$ref": "#/$defs/global_candidate"}
    }
  },
  "$defs": {
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 280
    },
    "project_object_id": {
      "type": "string",
      "pattern": "^mem:[a-z0-9][a-z0-9._-]{0,63}:(?:project|decision|component|task|bug|experiment|evidence|question):[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "maxLength": 128
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "confirmation_id", "evidence_ids"],
      "properties": {
        "summary": {"$ref": "#/$defs/summary"},
        "confirmation_id": {
          "type": ["string", "null"],
          "pattern": "^confirm:[a-z0-9][a-z0-9._-]{0,63}$",
          "maxLength": 72
        },
        "evidence_ids": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/project_object_id"}
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_id", "kind", "reference_id", "result"],
      "properties": {
        "evidence_id": {"$ref": "#/$defs/project_object_id"},
        "kind": {
          "enum": ["test", "repository_snapshot", "user_confirmation", "external_reference"]
        },
        "reference_id": {
          "type": "string",
          "pattern": "^ref:[a-z0-9][a-z0-9._-]{0,95}$",
          "maxLength": 100
        },
        "result": {"enum": ["pass", "fail", "partial", "unavailable"]}
      }
    },
    "open_task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "state"],
      "properties": {
        "summary": {"$ref": "#/$defs/summary"},
        "state": {"enum": ["open", "blocked", "deferred"]}
      }
    },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary"],
      "properties": {
        "summary": {"$ref": "#/$defs/summary"}
      }
    },
    "global_candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "source_object_ids"],
      "properties": {
        "summary": {"$ref": "#/$defs/summary"},
        "source_object_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/project_object_id"}
        }
      }
    }
  }
}
