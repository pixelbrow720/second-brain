{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pixel.local/schemas/activation-v2-a8-promotion-packet-v1.json",
  "title": "ActivationV2A8PromotionPacketV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "packet_id", "a7_packet_id", "a7_packet_digest", "corpus_id", "corpus_digest", "synthetic_project_id", "policy_digest", "implementation_digest", "expires_at", "review_mode", "candidates", "backup_required", "promotion_canary_required", "readback_required", "restore_required", "canary_sequence", "permission_impact", "rollback_trigger_codes", "network_permitted", "global_target_access", "global_mutation_authorized", "requires_current_user_approval", "approval_state", "fixture_only", "created_at", "packet_digest"],
  "properties": {
    "schema_version": {"const": 1},
    "packet_id": {"$ref": "#/$defs/packet_id"},
    "a7_packet_id": {"$ref": "#/$defs/a7_packet_id"},
    "a7_packet_digest": {"$ref": "#/$defs/hash"},
    "corpus_id": {"$ref": "#/$defs/corpus_id"},
    "corpus_digest": {"$ref": "#/$defs/hash"},
    "synthetic_project_id": {"$ref": "#/$defs/project_id"},
    "policy_digest": {"$ref": "#/$defs/hash"},
    "implementation_digest": {"$ref": "#/$defs/hash"},
    "expires_at": {"type": "string", "format": "date-time"},
    "review_mode": {"const": "PER_ITEM"},
    "candidates": {"type": "array", "minItems": 1, "maxItems": 8, "items": {"$ref": "#/$defs/candidate"}},
    "backup_required": {"const": true},
    "promotion_canary_required": {"const": true},
    "readback_required": {"const": true},
    "restore_required": {"const": true},
    "canary_sequence": {"const": ["backup", "promotion_canary", "readback", "restore"]},
    "permission_impact": {"const": "NONE_SYNTHETIC"},
    "rollback_trigger_codes": {"const": ["BOUNDARY_VIOLATION", "CAS_CONFLICT", "CROSS_PROJECT_LEAKAGE", "READBACK_MISMATCH", "REVIEW_MISMATCH", "SOURCE_DRIFT"]},
    "network_permitted": {"const": false},
    "global_target_access": {"const": false},
    "global_mutation_authorized": {"const": false},
    "requires_current_user_approval": {"const": true},
    "approval_state": {"const": "SYNTHETIC_DRAFT_NOT_APPROVED"},
    "fixture_only": {"const": true},
    "created_at": {"type": "string", "format": "date-time"},
    "packet_digest": {"$ref": "#/$defs/hash"}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$", "maxLength": 64},
    "project_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$", "maxLength": 64},
    "a7_packet_id": {"type": "string", "pattern": "^a7-packet:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$", "maxLength": 46},
    "corpus_id": {"type": "string", "pattern": "^a8-promotion-corpus:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$", "maxLength": 58},
    "packet_id": {"type": "string", "pattern": "^a8-packet:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$", "maxLength": 46},
    "candidate_id": {"type": "string", "pattern": "^a8-candidate:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$", "maxLength": 49},
    "global_object_id": {"type": "string", "pattern": "^kb:global:claim:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$", "maxLength": 64},
    "candidate": {
      "type": "object", "additionalProperties": false,
      "required": ["candidate_id", "source_project_id", "global_object_id", "current_revision", "before_digest", "candidate_after_digest", "candidate_digest"],
      "properties": {
        "candidate_id": {"$ref": "#/$defs/candidate_id"},
        "source_project_id": {"$ref": "#/$defs/project_id"},
        "global_object_id": {"$ref": "#/$defs/global_object_id"},
        "current_revision": {"type": "integer", "minimum": 0, "maximum": 2147483647},
        "before_digest": {"$ref": "#/$defs/hash"},
        "candidate_after_digest": {"$ref": "#/$defs/hash"},
        "candidate_digest": {"$ref": "#/$defs/hash"}
      }
    }
  }
}
