{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pixel.local/schemas/activation-v2-policy-inputs-v1.json",
  "title": "ActivationV2PolicyInputsV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "policy_version",
    "fixture_only",
    "retention_days",
    "capture_default",
    "storage_protection",
    "graph_ui",
    "router_entry_point",
    "promotion_review_mode",
    "policy_digest"
  ],
  "properties": {
    "policy_version": {"const": 1},
    "fixture_only": {"type": "boolean"},
    "retention_days": {"type": ["integer", "null"], "minimum": 1, "maximum": 3660},
    "capture_default": {"enum": ["UNSET", "OFF", "ASSISTED", "PROJECT_AUTO"]},
    "storage_protection": {"enum": ["UNSET", "ENCRYPTED_DISK", "APP_LEVEL_ENCRYPTION"]},
    "graph_ui": {"enum": ["UNSET", "GENERATED_SNAPSHOT", "LOCAL_WEB"]},
    "router_entry_point": {"enum": ["UNSET", "CLI_SHADOW", "DESKTOP_INTEGRATION"]},
    "promotion_review_mode": {"enum": ["UNSET", "PER_ITEM", "DAILY_BATCH", "MANUAL_ONLY"]},
    "policy_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$", "maxLength": 64}
  }
}
